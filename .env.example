# Kopieer naar .env.local en vul in. .env.local komt nooit in git.
# Te vinden in Supabase: Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheime sleutel (Project Settings -> API Keys -> secret). Enkel op de server gebruikt.
SUPABASE_SECRET_KEY=sb_secret_...
